#!/bin/sh
set -eu

backend_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -m)" in
    x86_64|amd64)
        backend="$backend_dir/x86_64/dms-screenshot-rs"
        ;;
    aarch64|arm64)
        backend="$backend_dir/aarch64/dms-screenshot-rs"
        ;;
    *)
        echo "dms-screenshot-rs: unsupported architecture: $(uname -m)" >&2
        exit 126
        ;;
esac

if [ ! -x "$backend" ]; then
    echo "dms-screenshot-rs: bundled binary is unavailable for $(uname -m)" >&2
    exit 126
fi

exec "$backend" "$@"
